# Ignore directories generated by Composer
/vendor/
/web/core/
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/
/web/libraries/

# Ignore Drupal site-specific files
/web/sites/*/files/
/web/sites/*/private/
/web/sites/*/settings.local.php
/web/sites/*/services.local.yml

# Environment and sensitive configuration
.env
.env.local
keys/
*.key

# Temporary files and caches
.phpunit.result.cache
.phpcs-cache
.cache/
*.log

# Keep custom modules, themes, and configuration sync
!/web/modules/custom/
!/web/themes/custom/
!/config/sync/

# OS and Editor artifacts
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
