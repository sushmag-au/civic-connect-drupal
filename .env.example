# ==============================================================================
# CivicConnect - Headless Drupal 11 Environment Configuration
# City of Greater Geelong Civic Portal
# ==============================================================================

# Database Connection (MySQL 8.0)
MYSQL_DATABASE=drupal
MYSQL_USER=drupal
MYSQL_PASSWORD=drupal
MYSQL_ROOT_PASSWORD=root
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_PREFIX=

# Drupal Core Security Hash Salt
# Generate a unique 64-character random string in production: openssl rand -hex 32
DRUPAL_HASH_SALT=civicconnect-geelong-band7-drupal11-portfolio-secure-salt-2026

# Simple OAuth (JWT / OAuth2 for Headless API Authentication)
SIMPLE_OAUTH_PUBLIC_KEY=../keys/public.key
SIMPLE_OAUTH_PRIVATE_KEY=../keys/private.key

# Decoupled Frontend Origin (Next.js 14)
NEXTJS_FRONTEND_URL=http://localhost:3000

# Container Port Bindings
NGINX_PORT=8080
MAILHOG_PORT=8025
DB_PORT=3306
